# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the required values.
# Do NOT commit the .env file containing real passwords to source control.
# ==============================================================================

# 1. ORACLE DATABASE PROPERTIES
ORACLE_SID=orcl
ORACLE_BASE=/u01/app/oracle
ORACLE_HOME=/u01/app/oracle/product/19.3.0/dbhome_1
ORACLE_USER=sys
ORACLE_PASSWORD=your_sysdba_password_here
ORACLE_WALLET_DIR=/u01/app/oracle/wallet

# 2. NETWORK PROXY CONFIGURATION
http_proxy=http://proxy.entreprise.internal:8080
https_proxy=http://proxy.entreprise.internal:8080
no_proxy=localhost,127.0.0.1,.entreprise.internal

# 3. RED HAT SATELLITE
SATELLITE_ORG=MonOrg
SATELLITE_ACTIVATION_KEY=Key-RHEL-9
SATELLITE_SERVER=satellite.entreprise.internal

# 4. MONITORING & ALERTS
ZABBIX_SERVER=zabbix.entreprise.internal
ZABBIX_AGENT_PORT=9100

# 5. VMWARE VCENTER SERVER
VCENTER_SERVER=vcenter01.solidairebanque.com
VCENTER_LOGIN=Administrator@vsphere.local
VCENTER_PASSWORD=your_vcenter_password_here

# 6. EMAIL & SMTP NOTIFICATION CONFIGURATION
SMTP_SERVER=solidairebanque-com.mail.protection.outlook.com
SMTP_PORT=25
SMTP_USE_TLS=true
SMTP_USER=dsi-automation@solidairebanque.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_SENDER=dsi-automation@solidairebanque.com
REPORT_RECIPIENTS=DSI@solidairebanque.com


