# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the required values.
# Do NOT commit the .env file containing real passwords to source control.
# ==============================================================================

# 1. ORACLE DATABASE PROPERTIES
ORACLE_SERVER=192.168.13.201
ORACLE_SID=SBCPROD
ORACLE_BASE=/oracle/app/oracle/
ORACLE_HOME=/oracle/app/oracle/product/19.0.0/dbhome_1/
ORACLE_USER=system
ORACLE_WALLET_DIR=/oracle/app/oracle/wallet

# 2. NETWORK PROXY CONFIGURATION
http_proxy=http://proxy.entreprise.internal:8080
https_proxy=http://proxy.entreprise.internal:8080
no_proxy=localhost,127.0.0.1,.entreprise.internal

# 3. RED HAT SATELLITE
SATELLITE_ORG="SOLIDAIRE BANQUE"
SATELLITE_ACTIVATION_KEY=ak_rhel9_prd
SATELLITE_SERVER=satellite.solidairebanque.com
SATELLITE_LOGIN=admin

# 4. MONITORING & ALERTS
ZABBIX_SERVER=192.168.200.130
ZABBIX_LOGIN=Admin
ZABBIX_AGENT_PORT=9100

# 5. ANSIBLE AUTOMATION PLATEFORM
ANSIBLE_SERVER=ansible-ap.solidairebanque.com
ANSIBLE_LOGIN=admin

# 6. VMWARE VCENTER SERVER
VCENTER_SERVER=vcenter01.solidairebanque.com
VCENTER_LOGIN=Administrator@vsphere.local

# 7. EMAIL & SMTP NOTIFICATION CONFIGURATION
SMTP_SERVER=solidairebanque-com.mail.protection.outlook.com
SMTP_PORT=25
SMTP_USE_TLS=true
SMTP_USER=monitoring@solidairebanque.com
SMTP_SENDER=monitoring@solidairebanque.com
REPORT_RECIPIENTS=DSI@solidairebanque.com